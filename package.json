{
  "name": "harness-remote",
  "version": "3.1.0",
  "type": "module",
  "bin": {
    "harness-remote": "bridge/src/launcher.js",
    "harness-remote-daemon": "bridge/src/daemon-bin.js",
    "harness-remote-copilot-smoke": "bridge/scripts/copilot-real-smoke.mjs",
    "harness-remote-opencode2-smoke": "bridge/scripts/opencode2-real-smoke.mjs",
    "harness-remote-mimo-smoke": "bridge/scripts/mimo-real-smoke.mjs",
    "harness-remote-web": "bridge/scripts/web-dev.mjs"
  },
  "scripts": {
    "start": "node bridge/src/launcher.js",
    "daemon": "node bridge/src/daemon-cli.js",
    "test": "npm --prefix bridge test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0"
  },
  "description": "Local-first control plane for native AI coding-agent sessions across Codex CLI, Claude Code, OpenCode, Oh My Pi and PI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giuliastro/harness-remote.git"
  },
  "homepage": "https://github.com/giuliastro/harness-remote",
  "keywords": [
    "ai-agents",
    "coding-agent",
    "coding-agents",
    "agent-harness",
    "native-sessions",
    "remote-development",
    "local-first",
    "codex",
    "claude-code",
    "opencode",
    "oh-my-pi",
    "pi",
    "acp",
    "android"
  ],
  "files": [
    "bridge/src",
    "bridge/scripts/copilot-real-smoke.mjs",
    "README.md",
    "LICENSE",
    "REFERENCE.md",
    "docs/QUICK_START.md",
    "bridge/scripts/acp-provider-real-smoke-lib.mjs",
    "bridge/scripts/opencode2-real-smoke.mjs",
    "bridge/scripts/mimo-real-smoke.mjs",
    "bridge/scripts/web-dev.mjs",
    "web/src",
    "web/public",
    "web/index.html",
    "web/vite.config.ts",
    "web/tsconfig.json",
    "web/tsconfig.app.json",
    "web/tsconfig.node.json",
    "web/package.json",
    "web/package-lock.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
